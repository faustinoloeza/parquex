{
  "name": "xcaret-maps-3d",
  "description": "Mapa 3D interactivo de los parques de Grupo Xcaret (Three.js)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*",
    "#parks/*": "./src/parks/*",
    "#models/*": "./src/models/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:fetch": "node pipeline/fetch.js",
    "data:satellite": "node pipeline/fetch-satellite.js",
    "data:build": "node pipeline/build.js",
    "data:overlay": "node pipeline/tools/debug-overlay.js",
    "data:compare": "node pipeline/tools/compare-landmarks.js",
    "data:festival": "node pipeline/fetch-festival.js",
    "export:glb": "node pipeline/export-glb.js",
    "export:mobile": "node pipeline/export-glb.js --mobile --android",
    "publish:models": "node pipeline/publish-models.js",
    "deploy:pages": "node pipeline/deploy-pages.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}

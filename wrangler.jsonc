// Cloudflare Worker that serves the built web map (static assets only, no code).
// Workers Builds: build command `npm run build`, deploy command `npx wrangler deploy`.
// Unknown paths (/xc/es, /xh/en…) answer with index.html: the app reads the route itself.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parquex",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}

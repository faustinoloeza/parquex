# Browser caching, read by Cloudflare (Workers static assets; GitHub Pages ignores this file).
# index.html keeps the default: checked on every visit, so a new deploy shows at once.

# the app's bundles have a content hash in their names: a new version is a new file
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# park data keeps its names between deploys: fresh for an hour, then still served
# right away while the browser checks for a newer copy in the background
/parks/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
